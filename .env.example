# ========================================================
# APEX LIBRARY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ========================================================

# Application Security
SECRET_KEY=generate-a-strong-random-secret-key-for-production
FLASK_ENV=production
FLASK_DEBUG=0

# ========================================================
# OPTION A: CLOUD DATABASE URI (Recommended for Vercel / Cloud)
# Supported: Aiven, TiDB Cloud, PlanetScale, AWS RDS, Clever Cloud, Railway, Supabase
# ========================================================
# DATABASE_URL=mysql+pymysql://username:password@remote-mysql-host.com:3306/library_db?ssl_verify_cert=true

# ========================================================
# OPTION B: DISCRETE MYSQL PARAMETERS (Local / Dedicated Server)
# ========================================================
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=library_db

# Fallback to local SQLite if MySQL is unreachable during development
FALLBACK_TO_SQLITE=True

# File Upload Limits (Bytes - Default: 16 MB)
MAX_CONTENT_LENGTH=16777216
